# Keep build contexts small and never send secrets to the daemon.
.git
.gitignore
.env
.env.*
!.env.example

# Dependencies and generated output are installed/built inside images.
**/node_modules
**/dist
**/.vite
**/coverage

# Brand source art is not a build input: the app serves its own copies from
# frontend/public and the docs site from docs/. Keep it out of build contexts.
assets/

# Runtime data and logs.
*.db
*.db-shm
*.db-wal
data/
*.log

# Local editor / OS noise.
.idea/
.vscode/
.DS_Store
