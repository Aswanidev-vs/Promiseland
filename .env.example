# PromisedLand — environment configuration template.
# Copy to `.env` and adjust for your machine. Never commit the copied file.
# `docker compose config -q` works without a `.env`; the fallbacks below are
# the same safe defaults used in docker-compose.yml.

# --- API process ---------------------------------------------------------
# Port the Go API listens on inside the container.
PORT=8080

# development | production. Production enables Secure session cookies.
APP_ENV=development

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGIN=http://localhost:5173

# Absolute path inside the API container. Backed by the named volume /data.
DATABASE_PATH=/data/promisedland.db

# Replace before any non-local use. Generate a long random value; store it
# only in your local .env or a secrets manager, never in source control.
SESSION_SECRET=change-me

# Uploaded images are stored on disk (never in SQLite). Inside Docker this is
# /data/media on the persistent volume; for local `go run` it defaults to
# ./data/media.
MEDIA_PATH=./data/media

# Optional: email address promoted to platform moderator at startup for local
# moderation testing. Leave blank in production and assign roles explicitly.
PLATFORM_MODERATOR_EMAIL=

# Adult dating is a later, separately gated product (PRD Release 5).
FEATURE_ADULT_DATING=false

# --- Frontend ------------------------------------------------------------
# Runtime upstream used by the frontend container's nginx (set by Compose).
API_UPSTREAM=http://api:8080

# Optional build-time override. The typed client already prefixes /api/v1;
# leave blank unless the frontend is explicitly updated to read this value.
VITE_API_BASE_URL=
